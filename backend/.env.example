APP_NAME=Shift Engine API
APP_VERSION=1.0.0
ENVIRONMENT=development

DATABASE_URL=
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REMEMBER_ME_EXPIRE_MINUTES=43200

CORS_ALLOWED_ORIGINS=

GOOGLE_SHEETS_CREDENTIALS_FILE=google-service-account-path
GOOGLE_SHEETS_SPREADSHEET_ID=your-sheet-id
GOOGLE_SHEETS_START_SHEET_NAME=Shift_Start
GOOGLE_SHEETS_END_SHEET_NAME=Shift_End
